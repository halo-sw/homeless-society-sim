# Copy to .env and fill in only what you have. Every key is optional:
# without keys the app runs in rule mode and the engine still computes
# every number. Never commit .env (it is in .gitignore).
#
# `docker compose up` reads it automatically. For the dev server, the
# relay or the judge CLI, load it into your shell first:
#   set -a; . ./.env; set +a; npm run dev

# Muse Spark 1.3 and Muse Voice Transcribe 1.0 at https://api.meta.ai/v1,
# model muse-spark-1.3 (web/src/judge/providers.js). Used by the
# consult chat and the household decisions. MODEL_API_KEY is still
# read as a fallback.
META_API_KEY=

# Muse Spark Open on Baseten — https://inference.baseten.co/v1,
# model meta-models/muse-spark-open-1026. Optional second provider
# (--provider baseten).
BASETEN_API_KEY=

# VWorld (Korea) map and aerial tiles. Streamed, never stored.
VWORLD_KEY=

# data.go.kr (공공데이터포털): the building register
# (pipeline/register_api.py). Only needed to rebuild data.
DATA_GO_KR_KEY=

# LH · 마이홈 public rental API (web/src/money/housing.js).
HOUSING_API_KEY=

# Relay only (docker compose sets a default).
ALLOWED_ORIGINS=http://localhost:8080
# Public data root the relay reads; defaults to https://halo-sw.github.io/ithaca/
DATA_BASE_URL=
